{
  "name": "macha-client-tizen-tv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build --mode samsung",
    "install-tv": "bash install-samsung.sh",
    "typecheck": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.node.json --pretty false",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@machafoundation/core": "file:../macha-ts",
    "foliate-js": "1.0.1",
    "hls.js": "1.6.18",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "terser": "^5.16.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  },
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  }
}
